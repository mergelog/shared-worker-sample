{
  "name": "shared-worker-sample",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "start": "concurrently -k -n api,angular \"npm:server\" \"ng serve\"",
    "server": "node server/index.mjs",
    "build": "npm run typecheck:worker && ng build",
    "typecheck:worker": "tsc -p tsconfig.worker.json",
    "preview": "node server/index.mjs --preview",
    "test": "npm run build && playwright test",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@angular/common": "^20.3.0",
    "@angular/compiler": "^20.3.0",
    "@angular/core": "^20.3.0",
    "@angular/forms": "^20.3.0",
    "@angular/platform-browser": "^20.3.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.8.1",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@angular/build": "^20.3.40",
    "@angular/cli": "^20.3.40",
    "@angular/compiler-cli": "^20.3.0",
    "@playwright/test": "^1.65.1",
    "concurrently": "^9.2.1",
    "typescript": "~5.9.2"
  }
}
